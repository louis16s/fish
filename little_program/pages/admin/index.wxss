.head-row { justify-content: space-between; }
.title2 { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.ipt {
  min-height: 78rpx;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12rpx;
  padding: 0 14rpx;
}
.field { margin-bottom: 12rpx; }
.lbl { display: block; color: rgba(165,180,207,.9); font-size: 24rpx; margin-bottom: 8rpx; }
.picker {
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12rpx;
  padding: 14rpx;
}
.urow, .drow { border-top: 1px solid rgba(255,255,255,.08); padding-top: 10rpx; margin-top: 10rpx; }
