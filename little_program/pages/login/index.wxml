<view class="container login-page">
  <view class="bg-orb bg-orb-a"></view>
  <view class="bg-orb bg-orb-b"></view>
  <view class="bg-grid"></view>

  <view class="login-shell">
    <view class="hero-card">
      <view class="hero-badge">智能水闸系统</view>
      <view class="hero-title">安全登录控制中心</view>
      <view class="hero-sub">查看实时水位、设备状态与运行记录</view>
      <view class="login-card">
        <view class="section-top">
          <view>
            <view class="title">账号登录</view>
            <view class="sub">请输入用户名和密码完成身份验证</view>
          </view>
          <view class="panel-line"></view>
        </view>

        <view class="field">
          <text class="lbl">用户名</text>
          <view class="input-wrap">
            <input class="ipt" placeholder="请输入用户名" value="{{username}}" bindinput="onUserInput" />
          </view>
        </view>

        <view class="field">
          <text class="lbl">密码</text>
          <view class="input-wrap">
            <input class="ipt" password="{{!showPassword}}" placeholder="请输入密码" value="{{password}}" bindinput="onPassInput" />
          </view>
        </view>

        <view class="toggle-panel">
          <view class="remember-row">
            <view>
              <view class="remember-label">记住密码</view>
              <view class="remember-desc">下次自动填充当前账号信息</view>
            </view>
            <switch checked="{{rememberPassword}}" color="#46d7c3" bindchange="onRememberChange" />
          </view>

          <view class="remember-row">
            <view>
              <view class="remember-label">显示密码</view>
              <view class="remember-desc">切换密码可见状态</view>
            </view>
            <switch checked="{{showPassword}}" color="#46d7c3" bindchange="onShowPasswordChange" />
          </view>
        </view>

        <button class="btn btn-primary login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">进入控制面板</button>

        <view wx:if="{{msg}}" class="err">{{msg}}</view>

      </view>
    </view>
  </view>
</view>
