.login-page {
  position: relative;
  overflow: hidden;
  padding: 36rpx 24rpx 56rpx;
}

.bg-orb {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(10rpx);
  opacity: 0.9;
}

.bg-orb-a {
  top: 90rpx;
  right: -70rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(70, 215, 195, 0.32), rgba(70, 215, 195, 0));
}

.bg-orb-b {
  left: -90rpx;
  bottom: 180rpx;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(79, 140, 255, 0.26), rgba(79, 140, 255, 0));
}

.bg-grid {
  position: absolute;
  inset: 0;
  opacity: 0.18;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
}

.login-shell {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  background:
    linear-gradient(140deg, rgba(70, 215, 195, 0.16), rgba(79, 140, 255, 0.08) 48%, rgba(255, 255, 255, 0.03) 100%),
    rgba(255, 255, 255, 0.05);
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.22);
}

.hero-card::after {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0));
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border: 1px solid rgba(70, 215, 195, 0.32);
  border-radius: 999rpx;
  background: rgba(70, 215, 195, 0.12);
  color: #b8fff1;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 52rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #f4f8ff;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.72;
  color: rgba(220, 231, 252, 0.82);
}

.login-card {
  margin-top: 28rpx;
  padding-top: 8rpx;
}

.section-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-line {
  margin-top: 10rpx;
  width: 88rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #46d7c3, #5ca3ff);
  box-shadow: 0 0 24rpx rgba(70, 215, 195, 0.28);
}

.field {
  margin-top: 22rpx;
}

.lbl {
  font-size: 23rpx;
  color: rgba(183, 198, 224, 0.92);
  letter-spacing: 1rpx;
}

.input-wrap {
  margin-top: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(3, 9, 23, 0.28));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.ipt {
  min-height: 88rpx;
  padding: 0 22rpx;
  border: 0;
  background: transparent;
  color: #eef5ff;
  font-size: 28rpx;
}

.toggle-panel {
  margin-top: 22rpx;
  padding: 8rpx 0;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.remember-row {
  padding: 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.remember-label {
  color: #eef5ff;
  font-size: 25rpx;
  font-weight: 600;
}

.remember-desc {
  margin-top: 6rpx;
  color: rgba(165, 180, 207, 0.9);
  font-size: 22rpx;
  line-height: 1.5;
}

.login-btn {
  margin-top: 28rpx;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(70, 215, 195, 0.9), rgba(92, 163, 255, 0.88));
  border-color: rgba(130, 226, 255, 0.38);
  box-shadow: 0 20rpx 40rpx rgba(54, 160, 201, 0.26);
}

.err {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #ffd5db;
  border: 1px solid rgba(251, 113, 133, 0.34);
  background: rgba(97, 22, 38, 0.38);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
}

.login-note {
  margin-top: 22rpx;
  display: grid;
  gap: 10rpx;
}

.login-note-item {
  padding-left: 18rpx;
  border-left: 4rpx solid rgba(70, 215, 195, 0.5);
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(181, 198, 226, 0.86);
}
