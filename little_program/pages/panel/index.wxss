.panel-page {
  background:
    radial-gradient(520rpx 360rpx at 0% 0%, rgba(34, 211, 238, 0.16), transparent 70%),
    linear-gradient(180deg, #08122b, #0a1736 55%, #08132e);
}

.head-row { justify-content: space-between; }

.title2 {
  font-size: 32rpx;
  font-weight: 760;
  margin-bottom: 14rpx;
  letter-spacing: 0.2rpx;
}

.hero-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.05));
  border-color: rgba(255, 255, 255, 0.18);
}

.hero-card.is-good {
  box-shadow: 0 18rpx 42rpx rgba(34, 197, 94, 0.14);
}

.hero-card.is-warn {
  box-shadow: 0 18rpx 42rpx rgba(245, 158, 11, 0.14);
}

.head-left {
  min-width: 0;
  flex: 1 1 auto;
}

.head-logout {
  margin: 0 !important;
  min-height: 64rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

.hero-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.picker {
  margin-top: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  background: rgba(2, 6, 23, 0.34);
  font-size: 26rpx;
  font-weight: 650;
}

.device-row {
  margin-top: 14rpx;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
}

.device-row .picker {
  margin-top: 0;
  flex: 1 1 auto;
  max-width: none;
  min-width: 0;
  padding: 14rpx 16rpx;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.device-status {
  margin-left: 0;
  flex: 0 0 auto;
  max-width: none;
  font-size: 19rpx;
  padding: 4rpx 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.quick-btn {
  margin: 0 !important;
  min-height: 66rpx;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border-color: rgba(255, 255, 255, 0.2);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.05));
  min-width: 0;
  padding: 0 6rpx;
  white-space: normal;
  line-height: 1.2;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gate-focus {
  border: 1px solid rgba(34, 211, 238, 0.28);
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(34, 211, 238, 0.14), rgba(2, 6, 23, 0.34));
  padding: 18rpx 16rpx;
  margin-bottom: 14rpx;
}

.gate-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.gate-title {
  font-size: 23rpx;
  color: rgba(165, 180, 207, 0.92);
}

.gate-main {
  font-size: 34rpx;
  font-weight: 760;
  color: #ecfeff;
}

.gate-progress {
  margin-top: 12rpx;
  height: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.12);
}

.gate-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #22d3ee, #38bdf8, #22c55e);
}

.gate-info-row {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: rgba(165, 180, 207, 0.9);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.metric-item {
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(2, 6, 23, 0.28);
  border-radius: 14rpx;
  padding: 12rpx 14rpx;
}

.metric-k {
  font-size: 22rpx;
  color: rgba(165, 180, 207, 0.88);
}

.metric-v {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #e7eefc;
  line-height: 1.2;
}

.metric-gate-wrap {
  margin-top: 8rpx;
}

.metric-gate-wide {
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(2, 6, 23, 0.28);
  border-radius: 14rpx;
  padding: 10rpx 14rpx 12rpx;
  margin-top: 12rpx;
}

.metric-gate-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  color: rgba(165, 180, 207, 0.9);
}

.metric-gate-progress {
  margin-top: 6rpx;
  height: 10rpx;
}

.metric-time {
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.schematic-canvas {
  width: 100%;
  height: 360rpx;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 14rpx;
  background: rgba(2, 6, 23, 0.58);
}

.schematic-legend {
  margin-top: 12rpx;
  gap: 8rpx;
}

.control-card {
  border-color: rgba(34, 211, 238, 0.28);
}

.control-hint {
  margin-top: -4rpx;
  margin-bottom: 14rpx;
  color: rgba(165, 180, 207, 0.9);
  font-size: 22rpx;
}

.control-block + .control-block {
  margin-top: 14rpx;
}

.control-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #c7d2fe;
  margin-bottom: 10rpx;
}

.manual-title {
  font-size: 30rpx;
}

.ctl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.gate-control-grid {
  gap: 12rpx;
}

.gate-control-grid .ctl-btn {
  flex: 0 0 calc((100% - 12rpx) / 2);
  max-width: calc((100% - 12rpx) / 2);
  box-sizing: border-box;
}

.auto-grid {
  display: flex !important;
  flex-wrap: wrap;
  gap: 8rpx;
}

.auto-grid .ctl-btn {
  flex: 0 0 calc((100% - 8rpx) / 2);
  max-width: calc((100% - 8rpx) / 2);
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
  font-size: 23rpx;
  padding: 0 4rpx;
  border-color: rgba(255, 255, 255, 0.14) !important;
  background: rgba(2, 6, 23, 0.46) !important;
  color: rgba(231, 238, 252, 0.96);
}
.manual-grid {
  display: flex;
  gap: 12rpx;
}

.manual-grid .ctl-btn {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  min-height: 66rpx;
  font-size: 24rpx;
  padding: 0 4rpx;
  white-space: nowrap;
  word-break: normal;
}

.manual-grid .ctl-btn[disabled] {
  background: rgba(255, 255, 255, 0.08) !important;
  border-color: rgba(255, 255, 255, 0.2) !important;
  color: rgba(231, 238, 252, 0.86) !important;
}

.ctl-btn {
  margin: 0 !important;
  width: auto;
  min-width: 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 730;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.06));
  border-color: rgba(255, 255, 255, 0.24);
  padding: 0 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
}

.ctl-open,
.ctl-stop,
.ctl-close {
  border-color: rgba(255, 255, 255, 0.24);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.06));
}

.ctl-neutral {
  border-color: rgba(255, 255, 255, 0.18);
  background: rgba(2, 6, 23, 0.42);
}

.ctl-open {
  border-color: rgba(34, 211, 238, 0.44);
  background: linear-gradient(180deg, rgba(34, 211, 238, 0.26), rgba(34, 211, 238, 0.12));
}

.ctl-stop {
  border-color: rgba(251, 113, 133, 0.44);
  background: linear-gradient(180deg, rgba(251, 113, 133, 0.24), rgba(251, 113, 133, 0.12));
}

.ctl-primary {
  border-color: rgba(34, 211, 238, 0.44);
  background: linear-gradient(180deg, rgba(34, 211, 238, 0.26), rgba(34, 211, 238, 0.12));
}

.ctl-warn {
  border-color: rgba(245, 158, 11, 0.78);
  background: linear-gradient(180deg, rgba(254, 240, 138, 0.96), rgba(245, 158, 11, 0.9));
  color: rgba(17, 24, 39, 0.96);
}

.cmd-msg {
  margin-top: 10rpx;
}

.ctl-btn[disabled] {
  opacity: 0.78;
  color: rgba(231, 238, 252, 0.88) !important;
}

.rule-head {
  width: 100%;
  justify-content: space-between;
  align-items: center;
  flex-wrap: nowrap;
}

.rule-refresh-btn {
  margin-left: auto !important;
  flex: 0 0 auto;
}

.summary-grid {
  display: grid;
  gap: 10rpx;
}

.summary-item {
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(2, 6, 23, 0.26);
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.summary-k {
  color: rgba(165, 180, 207, 0.9);
  font-size: 22rpx;
}

.summary-v {
  color: #e7eefc;
  font-size: 25rpx;
  font-weight: 700;
}

.summary-group {
  margin-top: 12rpx;
}

.summary-group-title {
  margin: 4rpx 2rpx 8rpx;
  color: rgba(165, 180, 207, 0.96);
  font-size: 22rpx;
  font-weight: 700;
}

.summary-detail-item {
  align-items: flex-start;
  gap: 14rpx;
}

.summary-detail-v {
  flex: 1 1 auto;
  text-align: right;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.summary-item-on {
  border-color: rgba(34, 211, 238, 0.32);
  background: rgba(34, 211, 238, 0.08);
}

.log-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: nowrap;
}

.log-head {
  flex-wrap: nowrap;
  align-items: center;
}

.log-head .title2 {
  margin-bottom: 0;
  white-space: nowrap;
}

.log-actions .btn {
  margin: 0 !important;
  min-height: 60rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
}

.logbox {
  max-height: 420rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  background: rgba(2, 6, 23, 0.5);
  padding: 12rpx;
}

.logtxt {
  white-space: pre-wrap;
  font-family: monospace;
  font-size: 22rpx;
}

@media (max-width: 720px) {
  .title {
    font-size: 32rpx;
  }

  .head-row {
    align-items: flex-start;
  }

  .head-logout {
    min-height: 58rpx;
    font-size: 22rpx;
    padding: 0 20rpx;
  }

  .log-actions {
    width: 100%;
    margin-left: 0;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .log-head .log-actions {
    width: auto;
    margin-left: auto;
    flex-wrap: nowrap;
  }
}
