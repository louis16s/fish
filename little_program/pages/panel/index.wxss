.head-row { justify-content: space-between; }
.picker {
  margin-top: 16rpx;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12rpx;
  padding: 14rpx;
}
.nav-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}
.nav-btn {
  width: 100%;
  font-size: 24rpx;
  line-height: 1.3;
}
.tags { margin-top: 14rpx; }
.title2 { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.kv { margin-bottom: 8rpx; }
.schematic {
  width: 100%;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 12rpx;
  background: rgba(2,6,23,.45);
}
.ctl-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}
.ctl-btn {
  width: 100%;
  min-height: 76rpx;
}
.ctl-span2 {
  grid-column: 1 / -1;
}
.tabs { margin-bottom: 10rpx; }
.logbox {
  max-height: 420rpx;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 12rpx;
  background: rgba(2,6,23,.5);
  padding: 12rpx;
}
.logtxt { white-space: pre-wrap; font-family: monospace; font-size: 22rpx; }

@media (max-width: 520rpx) {
  .nav-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
