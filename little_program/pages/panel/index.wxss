.head-row { justify-content: space-between; }
.head-left {
  min-width: 0;
  flex: 1 1 auto;
}
.head-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.mqtt-col {
  display: grid;
  gap: 8rpx;
  justify-items: end;
}
.head-logout {
  margin: 0 !important;
}
.picker {
  margin-top: 16rpx;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12rpx;
  padding: 14rpx;
}
.nav-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}
.nav-grid button,
.ctl-grid button {
  margin: 0 !important;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}
.nav-btn {
  width: 100%;
  font-size: 24rpx;
  line-height: 1.3;
  min-height: 64rpx;
  padding: 0 10rpx;
}
.tags { margin-top: 14rpx; }
.title2 { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.rule-head {
  width: 100%;
  justify-content: space-between;
  align-items: center;
  flex-wrap: nowrap;
}
.rule-refresh-btn {
  margin-left: auto !important;
  flex: 0 0 auto;
}
.kv { margin-bottom: 8rpx; }
.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}
.metric-item {
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
}
.metric-k {
  font-size: 22rpx;
  color: rgba(165,180,207,.88);
}
.metric-v {
  margin-top: 4rpx;
  font-size: 27rpx;
  font-weight: 650;
  color: #e7eefc;
}
.schematic-canvas {
  width: 100%;
  height: 360rpx;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12rpx;
  background: rgba(2,6,23,.55);
}
.schematic-legend {
  margin-top: 10rpx;
  gap: 8rpx;
}
.ctl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.ctl-btn {
  width: calc((100% - 10rpx) / 2);
  min-height: 84rpx;
  padding: 0 10rpx;
  background: linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.05));
  border-color: rgba(255,255,255,.22);
  font-weight: 700;
  flex: 0 0 calc((100% - 10rpx) / 2);
}
.ctl-btn[disabled] {
  opacity: .68;
  color: rgba(231,238,252,.72) !important;
  background: linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.05)) !important;
  border-color: rgba(255,255,255,.22) !important;
}
.ctl-span2 {
  width: 100%;
  flex: 0 0 100%;
}
.log-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: nowrap;
}
.log-actions .btn {
  margin: 0 !important;
  min-height: 56rpx;
  font-size: 22rpx;
  padding: 0 12rpx;
}
.logbox {
  max-height: 420rpx;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 12rpx;
  background: rgba(2,6,23,.5);
  padding: 12rpx;
}
.logtxt { white-space: pre-wrap; font-family: monospace; font-size: 22rpx; }

@media (max-width: 520rpx) {
  .nav-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .head-row {
    align-items: flex-start;
  }
  .head-right {
    flex-direction: column;
    align-items: flex-end;
  }
  .log-actions {
    width: 100%;
    margin-left: 0;
    justify-content: flex-end;
  }
}
