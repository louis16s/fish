<view class="container">
  <view class="card">
    <view class="row head-row">
      <view>
        <view class="title">水闸控制面板</view>
        <view class="sub">{{userText}}</view>
      </view>
      <button class="btn btn-danger" size="mini" bindtap="logout">退出</button>
    </view>

    <picker mode="selector" range="{{deviceOptions}}" range-key="label" value="{{deviceIndex}}" bindchange="onDeviceChange">
      <view class="picker">当前设备：{{currentDeviceLabel}}</view>
    </picker>

    <view class="nav-grid">
      <button class="btn nav-btn" size="mini" bindtap="goDeviceConfig">设备配置</button>
      <button class="btn nav-btn" size="mini" bindtap="goReplay">回放</button>
      <button class="btn nav-btn" size="mini" bindtap="goAdmin">管理</button>
      <button class="btn nav-btn" size="mini" bindtap="refreshAll">刷新</button>
    </view>

    <view class="row tags">
      <text class="tag {{serverMqttTagClass}}">{{serverMqttText}}</text>
      <text class="tag {{deviceOnlineTagClass}}">{{deviceOnlineText}}</text>
      <text class="tag">最近上报 {{lastTelemetryAt}}</text>
      <text class="tag">FW {{fwVersion}}</text>
    </view>
  </view>

  <view class="card">
    <view class="title2">实时状态</view>
    <view class="metric-grid">
      <view class="metric-item">
        <view class="metric-k">内塘</view>
        <view class="metric-v">{{innerText}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-k">外塘</view>
        <view class="metric-v">{{outerText}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-k">水位差</view>
        <view class="metric-v">{{deltaText}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-k">闸门</view>
        <view class="metric-v">{{gateText}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-k">自动</view>
        <view class="metric-v">{{autoText}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-k">告警</view>
        <view class="metric-v">{{alarmText}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="title2">示意图</view>
    <canvas type="2d" id="schematicCanvas" class="schematic-canvas"></canvas>
    <view class="row schematic-legend">
      <text class="tag">内塘 {{innerText}}</text>
      <text class="tag">外塘 {{outerText}}</text>
      <text class="tag {{gateTagClass}}">闸门 {{gateText}}</text>
      <text class="tag {{deltaTagClass}}">Δ {{deltaText}}</text>
    </view>
    <view wx:if="{{schematicMsg}}" class="muted">{{schematicMsg}}</view>
  </view>

  <view class="card">
    <view class="title2">控制</view>
    <view class="ctl-grid">
      <button class="btn ctl-btn" loading="{{cmdLoading}}" disabled="{{cmdLoading}}" bindtap="cmdGateOpen">开闸</button>
      <button class="btn ctl-btn" loading="{{cmdLoading}}" disabled="{{cmdLoading}}" bindtap="cmdGateClose">关闸</button>
      <button class="btn ctl-btn" loading="{{cmdLoading}}" disabled="{{cmdLoading}}" bindtap="cmdGateStop">停止</button>
      <button class="btn ctl-btn" loading="{{cmdLoading}}" disabled="{{cmdLoading}}" bindtap="cmdAutoOn">自动开</button>
      <button class="btn ctl-btn" loading="{{cmdLoading}}" disabled="{{cmdLoading}}" bindtap="cmdAutoOff">自动关</button>
      <button class="btn ctl-btn" loading="{{cmdLoading}}" disabled="{{cmdLoading}}" bindtap="cmdAutoLatchOff">解除锁定</button>
      <button class="btn ctl-btn ctl-span2" loading="{{cmdLoading}}" disabled="{{cmdLoading}}" bindtap="cmdManualEnd">结束手动</button>
    </view>
    <view wx:if="{{cmdMsg}}" class="muted">{{cmdMsg}}</view>
  </view>

  <view class="card">
    <view class="row head-row">
      <view class="title2">规则摘要</view>
      <button class="btn" size="mini" bindtap="loadConfigSummary">刷新</button>
    </view>
    <view class="kv">模式：{{cfgSummary.mode}}</view>
    <view class="kv">时区：{{cfgSummary.tz}}</view>
    <view class="kv">定时启用：{{cfgSummary.daily}}</view>
    <view class="kv">循环启用：{{cfgSummary.cycle}}</view>
    <view class="kv">水位差启用：{{cfgSummary.leveldiff}}</view>
    <view wx:if="{{cfgSummary.msg}}" class="muted">{{cfgSummary.msg}}</view>
  </view>

  <view class="card">
    <view class="row head-row">
      <view class="title2">日志</view>
      <view class="row">
        <button class="btn" size="mini" bindtap="refreshLog">刷新</button>
        <button class="btn btn-danger" size="mini" bindtap="clearLog">清空</button>
      </view>
    </view>

    <view class="row tabs">
      <button class="btn {{logTab==='error'?'btn-primary':''}}" size="mini" data-tab="error" bindtap="setLogTab">error</button>
      <button class="btn {{logTab==='measure'?'btn-primary':''}}" size="mini" data-tab="measure" bindtap="setLogTab">measure</button>
      <button class="btn {{logTab==='action'?'btn-primary':''}}" size="mini" data-tab="action" bindtap="setLogTab">action</button>
    </view>

    <scroll-view scroll-y="true" class="logbox">
      <text class="logtxt">{{logText}}</text>
    </scroll-view>
    <view wx:if="{{logMsg}}" class="muted">{{logMsg}}</view>
  </view>
</view>
