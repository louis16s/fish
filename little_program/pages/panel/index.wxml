<view class="container panel-page">
  <view class="card hero-card {{pageStatusClass}}">
    <view class="row head-row">
      <view class="head-left">
        <view class="title">水闸控制面板</view>
        <view class="sub">{{userText}}</view>
      </view>
      <button class="btn btn-danger head-logout" size="mini" bindtap="logout">退出</button>
    </view>

    <view class="row device-row">
      <picker mode="selector" range="{{deviceOptions}}" range-key="label" value="{{deviceIndex}}" bindchange="onDeviceChange">
        <view class="picker">设备：{{currentDeviceLabel}}</view>
      </picker>
      <text class="tag device-status {{serverMqttTagClass}}">{{serverMqttText}}</text>
      <text class="tag device-status {{deviceOnlineTagClass}}">{{deviceOnlineText}}</text>
    </view>

    <view class="quick-grid">
      <button class="btn quick-btn" size="mini" bindtap="goDeviceConfig">规则</button>
      <button class="btn quick-btn" size="mini" bindtap="goReplay">回放</button>
      <button class="btn quick-btn" size="mini" bindtap="goAdmin">管理</button>
    </view>
  </view>

  <view class="card">
    <view class="section-head">
      <view class="title2">实时状态</view>
    </view>

    <view wx:if="{{deviceOnline}}" class="gate-focus">
      <view class="gate-title-row">
        <view class="gate-title">闸门状态</view>
        <view class="gate-main">{{gateText}}</view>
      </view>
      <view class="gate-info-row">
        <text>自动：{{autoText}}</text>
        <text>告警：{{alarmText}}</text>
      </view>
    </view>

    <view class="metric-grid">
      <view class="metric-item">
        <view class="metric-k">内塘水位</view>
        <view class="metric-v">{{innerStatusText}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-k">外塘水位</view>
        <view class="metric-v">{{outerStatusText}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-k">水位差</view>
        <view class="metric-v">{{deltaText}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-k">最近上报</view>
        <view class="metric-v metric-time">{{lastTelemetryAt}}</view>
      </view>
    </view>
    <view wx:if="{{deviceOnline}}" class="metric-gate-wrap metric-gate-wide">
      <view class="metric-gate-row">
        <text>闸门 {{gateText}}</text>
        <text>{{gateProgress}}%</text>
      </view>
      <view class="gate-progress metric-gate-progress">
        <view class="gate-progress-fill" style="width: {{gateProgress}}%;"></view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="title2">运行示意图</view>
    <canvas type="2d" id="schematicCanvas" class="schematic-canvas"></canvas>
    <view class="row schematic-legend">
      <text class="tag">内塘 {{innerText}}</text>
      <text class="tag">外塘 {{outerText}}</text>
      <text class="tag">Δ {{deltaText}}</text>
    </view>
    <view wx:if="{{schematicMsg}}" class="muted">{{schematicMsg}}</view>
  </view>

  <view class="card control-card">
    <view class="title2">阀门控制</view>
    <view class="control-hint">离线或 MQTT 断开时将自动禁用控制按钮</view>
    <view class="ctl-grid gate-control-grid">
      <button class="btn ctl-btn ctl-open" loading="{{cmdLoading}}" disabled="{{cmdLoading || !canOperate}}" bindtap="cmdGateOpen">开闸</button>
      <button class="btn ctl-btn ctl-neutral" loading="{{cmdLoading}}" disabled="{{cmdLoading || !canOperate}}" bindtap="cmdGateClose">关闸</button>
      <button class="btn ctl-btn ctl-stop" loading="{{cmdLoading}}" disabled="{{cmdLoading || !canOperate}}" bindtap="cmdGateStop">停止</button>
      <button class="btn ctl-btn {{autoToggleClass}}" loading="{{cmdLoading}}" disabled="{{cmdLoading || !canOperate}}" bindtap="cmdAutoToggle">{{autoToggleText}}</button>
    </view>
    <view wx:if="{{cmdMsg}}" class="muted cmd-msg">{{cmdMsg}}</view>
  </view>

  <view class="card">
    <view class="row head-row rule-head">
      <view class="title2">规则摘要</view>
      <button class="btn rule-refresh-btn" size="mini" bindtap="loadConfigSummary">刷新</button>
    </view>
    <view class="summary-grid">
      <view class="summary-item"><text class="summary-k">模式</text><text class="summary-v">{{cfgSummary.mode}}</text></view>
      <view class="summary-item"><text class="summary-k">时区</text><text class="summary-v">{{cfgSummary.tz}}</text></view>
    </view>
    <view class="summary-group">
      <view class="summary-group-title">定时规则（daily）</view>
      <block wx:for="{{cfgSummary.dailyItems}}" wx:for-item="it" wx:key="title">
        <view class="summary-item summary-detail-item {{it.on ? 'summary-item-on' : ''}}">
          <text class="summary-k">{{it.title}}</text>
          <text class="summary-v summary-detail-v">{{it.value}}</text>
        </view>
      </block>
    </view>
    <view class="summary-group">
      <view class="summary-group-title">循环规则（cycle）</view>
      <block wx:for="{{cfgSummary.cycleItems}}" wx:for-item="it" wx:key="title">
        <view class="summary-item summary-detail-item {{it.on ? 'summary-item-on' : ''}}">
          <text class="summary-k">{{it.title}}</text>
          <text class="summary-v summary-detail-v">{{it.value}}</text>
        </view>
      </block>
    </view>
    <view class="summary-group">
      <view class="summary-group-title">水位差规则（leveldiff）</view>
      <block wx:for="{{cfgSummary.leveldiffItems}}" wx:for-item="it" wx:key="title">
        <view class="summary-item summary-detail-item {{it.on ? 'summary-item-on' : ''}}">
          <text class="summary-k">{{it.title}}</text>
          <text class="summary-v summary-detail-v">{{it.value}}</text>
        </view>
      </block>
    </view>
    <view wx:if="{{cfgSummary.msg}}" class="muted">{{cfgSummary.msg}}</view>
  </view>

  <view class="card" id="logCard">
    <view class="row head-row log-head">
      <view class="title2">日志</view>
      <view class="log-actions">
        <button class="btn {{logTab==='error'?'btn-primary':''}}" size="mini" data-tab="error" bindtap="setLogTab">错误</button>
        <button class="btn {{logTab==='measure'?'btn-primary':''}}" size="mini" data-tab="measure" bindtap="setLogTab">测量</button>
        <button class="btn {{logTab==='action'?'btn-primary':''}}" size="mini" data-tab="action" bindtap="setLogTab">动作</button>
        <button class="btn" size="mini" bindtap="refreshLog">刷新</button>
        <button class="btn btn-danger" size="mini" bindtap="clearLog">清空</button>
      </view>
    </view>

    <scroll-view scroll-y="true" class="logbox">
      <text class="logtxt">{{logText}}</text>
    </scroll-view>
    <view wx:if="{{logMsg}}" class="muted">{{logMsg}}</view>
  </view>
</view>
