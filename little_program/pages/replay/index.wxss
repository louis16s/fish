.head-row { justify-content: space-between; }
.page-head {
  align-items: flex-start;
  flex-wrap: nowrap;
}
.head-title {
  min-width: 0;
  flex: 1 1 auto;
}
.back-btn {
  margin-left: auto !important;
  flex: 0 0 auto;
}
.picker {
  margin-top: 16rpx;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12rpx;
  padding: 14rpx;
}
.btn-row {
  justify-content: flex-end;
  align-items: center;
  flex-wrap: wrap;
}
.btn-row .btn {
  flex: 0 0 auto;
}
.field { margin-top: 14rpx; }
.lbl { display: block; color: rgba(165,180,207,.9); font-size: 24rpx; margin-bottom: 8rpx; }
.ipt {
  min-height: 78rpx;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12rpx;
  padding: 0 14rpx;
}
.title2 { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.canvas {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(2,6,23,.45);
}
.legend-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: rgba(165,180,207,.92);
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
}
.dot-inner { background: #4ade80; }
.dot-outer { background: #38bdf8; }
.table-head {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: 48rpx 210rpx 1fr 1fr;
  gap: 8rpx;
  padding: 8rpx 0;
  border-bottom: 1px solid rgba(255,255,255,.12);
}
.th {
  font-size: 22rpx;
  color: rgba(165,180,207,.94);
}
.list { max-height: 640rpx; }
.row-item { padding: 10rpx 0; border-bottom: 1px solid rgba(255,255,255,.08); }
.row-line {
  display: grid;
  grid-template-columns: 48rpx 210rpx 1fr 1fr;
  gap: 8rpx;
}
.cell {
  font-size: 22rpx;
  color: #e7eefc;
  line-height: 1.35;
  word-break: break-all;
}
.idx { text-align: right; }

@media (max-width: 520rpx) {
  .btn-row {
    gap: 10rpx;
  }
  .btn-row .btn {
    min-height: 60rpx;
  }
  .table-head,
  .row-line {
    grid-template-columns: 40rpx 170rpx 1fr;
  }
  .th.st,
  .cell.st {
    grid-column: 1 / -1;
  }
}
